"""fastverk mdBook theme — the brand applied to docs, templated via brando.

`@brand//mdbook:theme` is an mdBook `theme/` overlay generated by brando's
brand_mdbook_theme from the fastverk palette + Space Grotesk faces + the
canonical mark as favicon. The result is a pure static filegroup (no toolchain
deps), so any repo can consume it as its theme dir; pair with book.toml:

    [output.html]
    additional-css = ["theme/css/custom.css"]
"""

load("@brando//:defs.bzl", "brand_mdbook_theme")

package(default_visibility = ["//visibility:public"])

# brando 0.2.0: the palette comes from the SKIN. The seven colour attributes that
# used to be here were the third place fastverk typed its palette, after
# skins/fastverk.textpb and gen/gen_mark.py's Spec — and they matched the skin
# exactly, which is the good outcome of a habit that also produced the LaTeX
# class's drifted accent (see //doc:classes).
brand_mdbook_theme(
    name = "theme",
    favicon = "//gen:fastverk_full.svg",
    font_family = "Space Grotesk",
    medium_ttf = "//fonts:SpaceGrotesk-Medium.ttf",
    # NOT a Theme role, and not the same colour as the skin's `border` (#2A2C33).
    # mdBook wants a slate for its rules; meridian.theme.v1 has no such role, so
    # this stays explicit rather than being collapsed onto the nearest one.
    overrides = {"DARK_BORDER": "#4A565A"},
    semibold_ttf = "//fonts:SpaceGrotesk-SemiBold.ttf",
    skin = "//skins:fastverk_json",
)
